<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(DUODASH_DISPLAY_NAME)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>bluetooth-central</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Duo Dash uses your location to show you on the map and give turn-by-turn directions.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Duo Dash keeps following your route when the screen is locked or another app is in front.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Duo Dash plays and controls your Apple Music library from the dashboard.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Duo Dash listens when you tap a microphone button, so you can search, message and ask the assistant by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Duo Dash turns what you say into text for searches, messages and the driving assistant.</string>
	<key>NSContactsUsageDescription</key>
	<string>Duo Dash shows your favourite contacts so you can call or message them with one tap.</string>
	<key>SpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>
	<key>SpotifyRedirectURI</key>
	<string>duodash://spotify-callback</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>duodash</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
		<string>facetime-audio</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Duo Dash shows your next event on the dashboard and gives one-tap directions to it.</string>
	<key>NSCameraUsageDescription</key>
	<string>Duo Dash uses the rear camera as a dashcam, recording the road ahead while it's on screen.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Duo Dash saves dashcam clips you choose to your photo library.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Duo Dash shows your garage door, locks, lights and scenes on the dashboard so you can open the garage or turn on the lights from the car.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Duo Dash connects to your Bluetooth OBD-II adapter to show live engine data, battery voltage and check-engine codes.</string>
	<key>DuoDashEdition</key>
	<string>$(DUODASH_EDITION)</string>
	<key>DuoDashHomeKit</key>
	<string>$(DUODASH_HOMEKIT)</string>
</dict>
</plist>
