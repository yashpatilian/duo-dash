<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(DUODASH_DISPLAY_NAME)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Duo Dash uses your location to show you on the map and give turn-by-turn directions.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Duo Dash keeps following your route when the screen is locked or another app is in front.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Duo Dash plays and controls your Apple Music library from the dashboard.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Duo Dash listens when you tap a microphone button, so you can search, message and ask the assistant by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Duo Dash turns what you say into text for searches, messages and the driving assistant.</string>
	<key>NSContactsUsageDescription</key>
	<string>Duo Dash shows your favourite contacts so you can call or message them with one tap.</string>
	<key>SpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>
	<key>SpotifyRedirectURI</key>
	<string>duodash://spotify-callback</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>duodash</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
